@startuml UC2_Request_FHIR4_Health_Data
!theme plain
title C4 Level 4 — Code Diagram: UC2 Request FHIR 4 Health Data (extends UC1)

package "WAH Hospital (React/Next.js)" {
    class RequestDataPage {
        + handleSubmit()
    }
    class "POST /api/requests" as WAHRequestAPI <<Route Handler>> {
        + POST(req: Request)
    }
}

package "ADAPT iPaaS Middleware (Golang)" {
    class RequestHandler <<struct>> {
        + mongoRepo: MongoDBRepository
        + HandleRequest(w: ResponseWriter, r: Request)
    }
    class MongoDBRepository <<struct>> {
        + InsertTransaction(tx: Transaction): ObjectID
    }
}

package "iHOMIS Portal (React/Next.js)" {
    class "POST /api/incoming-requests" as iHOMISIncomingAPI <<Route Handler>> {
        + POST(req: Request)
    }
}

class "WAH Staff" as WAHStaff <<Actor>>

WAHStaff --> RequestDataPage : Fills FHIR R4 data request form
RequestDataPage --> WAHRequestAPI : fetch('/api/requests')
WAHRequestAPI --> RequestHandler : HTTP POST /api/v1/request
RequestHandler --> MongoDBRepository : repo.InsertTransaction(tx)
RequestHandler --> iHOMISIncomingAPI : HTTP POST /incoming-requests
iHOMISIncomingAPI ..> RequestHandler : Returns 200 OK
RequestHandler ..> WAHRequestAPI : Returns {success:true, status:'PENDING'}

note right of RequestDataPage
  Form UI. Sets destination_format='FHIR_R4'.
  Submits to local /api/requests.
end note

note right of WAHRequestAPI
  Constructs body with {requesting_org:'WAH', 
  destination_format:'FHIR_R4'}. POSTs to ADAPT.
end note

note right of RequestHandler
  Detects isWAHRequesting=true. 
  Sets srcFormat='HL7V2', dstFormat='FHIR_R4'.
  Calls DB to log PENDING.
  Forwards to iHOMIS /api/incoming-requests.
end note

note right of MongoDBRepository
  Inserts document into adapt_transaction_logs 
  collection with status='PENDING'.
end note

note right of iHOMISIncomingAPI
  Receives forwarded data request.
  Stores in iHOMIS request store.
  Shows in clinician inbox for approval.
end note

@enduml
