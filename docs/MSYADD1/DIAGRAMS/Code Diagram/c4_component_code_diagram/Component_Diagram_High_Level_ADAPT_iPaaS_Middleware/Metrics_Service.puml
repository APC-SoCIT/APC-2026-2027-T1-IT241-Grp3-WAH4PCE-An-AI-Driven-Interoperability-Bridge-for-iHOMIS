@startuml Metrics_Service
!theme plain
title C4 Level 4 - Code Diagram: Metrics Service

package "src/app/api/metrics" {
    class "route.ts" as RouteHandler <<Next.js Route>> {
        + GET(req: Request): Response
    }
    
    class MetricsController <<Class>> {
        + calculateTelemetry(): MetricsData
    }
}

package "src/lib" {
    class SupabaseClient <<Database>>
}

RouteHandler --> MetricsController : delegates
MetricsController --> SupabaseClient : aggregates transaction stats

@enduml
