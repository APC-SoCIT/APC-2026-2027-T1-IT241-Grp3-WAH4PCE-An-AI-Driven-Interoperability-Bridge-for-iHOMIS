@startuml UC3_Provide_Health_Data
!theme plain
title C4 Level 4 — Code Diagram: UC3 Provide Health Data

package "iHOMIS Portal (React/Next.js)" {
    class SavePage {
        + handleSave()
    }
    class "POST /api/ingest" as iHOMISIngestProxy <<Route Handler>> {
        + POST(req: Request)
    }
}

package "ADAPT iPaaS Middleware (Golang)" {
    class IngestHandler <<struct>> {
        + mongoRepo: MongoDBRepository
        + aiService: AIService
        + validatorSvc: ValidationService
        + HandleIngest(w: ResponseWriter, r: Request)
    }
    class MongoDBRepository <<struct>> {
        + UpdateStatus(txID: String, status: String)
    }
    class AIService <<struct>> {
        + TransformWithAI(payload: String, direction: String): TransformResult
    }
    class ValidationService <<struct>> {
        + ValidateTransformation(data: String, direction: String): ValidationResult
    }
}

package "WAH Hospital (React/Next.js)" {
    class "POST /api/webhook" as WAHWebhook <<Route Handler>> {
        + POST(req: Request)
    }
}

class "Clinician / Staff" as Clinician <<Actor>>

Clinician --> SavePage : Fills record and ticks consent
SavePage --> iHOMISIngestProxy : fetch('/api/ingest')
iHOMISIngestProxy --> IngestHandler : HTTP POST /api/v1/ingest
IngestHandler --> MongoDBRepository : repo.UpdateStatus(txID, 'TRANSFORMING')
IngestHandler --> AIService : aiService.TransformWithAI()
IngestHandler --> ValidationService : validator.ValidateTransformation()
IngestHandler --> MongoDBRepository : repo.UpdateStatus(txID, 'SUCCESS')
IngestHandler --> WAHWebhook : HTTP POST (FHIRBundle)
IngestHandler ..> iHOMISIngestProxy : Returns {success:true, status:'SUCCESS'}

note right of SavePage
  Multi-step form.
  Checks consentSigned===true before proceeding.
end note

note right of iHOMISIngestProxy
  Receives form data. Packages as HL7V2 payload.
  Forwards to ADAPT iPaaS.
end note

note bottom of IngestHandler
  Main ingestion pipeline.
  Validates fields & consent. Updates to TRANSFORMING.
  Calls AI. Validates output.
  Forwards to WAH.
end note

@enduml
