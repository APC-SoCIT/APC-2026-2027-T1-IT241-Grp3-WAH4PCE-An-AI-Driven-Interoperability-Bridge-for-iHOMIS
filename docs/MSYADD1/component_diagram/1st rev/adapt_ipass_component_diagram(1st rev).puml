@startuml ADAPT_iPaaS_Component_Diagram
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Component Diagram for ADAPT iPaaS Middleware

Person(admin, "System Admin", "IT administrator who monitors the interoperability pipeline, views logs, and manages config.")

System_Ext(gemini, "Google Gemini AI", "Primary AI provider for record transformation.")
System_Ext(groq, "Groq API", "Fallback AI provider.")
SystemDb_Ext(supabase, "Supabase Database", "Stores transaction logs and metrics.")

System_Ext(requester, "Data Requester", "External system requesting data.")
System_Ext(provider, "Data Provider", "External system providing approved records.")

Container_Boundary(adapt_ipaas, "ADAPT iPaaS") {

Component(dashboard, "Admin Dashboard", "Web UI", "Monitor metrics, view logs, test transforms, and configure AI models.")

Container_Boundary(api_layer, "API Layer") {
    Component(request_api, "Request API", "API", "Handles bidirectional data requests. Logs Pending transaction.")
    Component(ingest_api, "Ingest API", "API", "Receives approved records. Runs AI transformation, validates, forwards.")
    Component(decline_api, "Decline API", "API", "Handles request declines. Marks transaction as Quarantined.")
}

Container_Boundary(core_services, "Core Services") {
    Component(ai_svc, "AI Transformation Service", "Service", "Converts records across formats using a chain of AI models.")
    Component(validator, "Validation Service", "Service", "Checks that transformed record is complete and correct.")
    Component(tx_log, "Transaction Log Service", "Service", "Records every event and tracks status.")
    Component(metrics, "Metrics Service", "Service", "Aggregates transaction counts by status, direction, format.")
}
}

Rel(admin, dashboard, "Monitors dashboard, views logs and config", "HTTPS")

Rel(dashboard, ingest_api, "Tests transforms", "POST /api/ingest")
Rel(dashboard, tx_log, "Fetches logs", "GET /api/transactions")
Rel(dashboard, metrics, "Fetches stats", "GET /api/metrics")

Rel(requester, request_api, "Data request", "POST /api/request")
Rel(provider, ingest_api, "Approved record", "POST /api/ingest")
Rel(provider, decline_api, "Declines request", "POST /api/decline")

Rel(request_api, tx_log, "Logs request as Pending")
Rel(decline_api, tx_log, "Updates to Quarantined")

Rel(ingest_api, ai_svc, "Requests transformation")
Rel(ingest_api, validator, "Validates output")
Rel(ingest_api, tx_log, "Logs status and payload")

Rel(ingest_api, requester, "Transformed record/bundle", "POST /api/webhook")
Rel(request_api, provider, "Forwards data request", "POST /api/requests")
Rel(decline_api, requester, "Notifies of decline", "POST /api/webhook")

Rel(ai_svc, gemini, "Transformation request (Primary)")
Rel(ai_svc, groq, "Transformation request (Fallback)")
Rel(tx_log, supabase, "Reads/writes logs", "REST API")
Rel(metrics, supabase, "Reads counts", "REST API")

@enduml

