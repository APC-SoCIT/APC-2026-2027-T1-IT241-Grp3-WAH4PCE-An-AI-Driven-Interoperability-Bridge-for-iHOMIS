@startuml UC8_Administer_System
!theme plain
title C4 Level 4 — Code Diagram: UC8 Administer System

class "System Admin" as Admin <<Actor>>

package "ADAPT Admin Dashboard (React/Next.js)" {
    class Middleware <<Proxy>> {
        + validateSession()
    }
    class LoginPage {
        + handleSubmit()
    }
    class DashboardPage {
        + fetchMetrics()
    }
    class TransactionLogsPage {
        + fetchLogs()
    }
    class DataMapperPage {
        + fetchTransaction()
    }
}

package "ADAPT iPaaS Middleware (Golang)" {
    class AuthHandler <<struct>> {
        + mongoRepo: MongoRepository
        + Login(w: ResponseWriter, r: Request)
    }
    class MetricsHandler <<struct>> {
        + mongoRepo: MongoRepository
        + GetMetrics(w: ResponseWriter, r: Request)
    }
    class TransactionsHandler <<struct>> {
        + mongoRepo: MongoRepository
        + GetTransactions(w: ResponseWriter, r: Request)
        + GetTransactionByID(w: ResponseWriter, r: Request)
    }
    class MongoRepository <<struct>> {
        + VerifyCredentials(user: String, hash: String): User
        + GetMetricsAggregation(): Metrics
        + GetTransactions(filters: Map): []Transaction
    }
}

class "MongoDB" as MongoDB <<Database>>

Admin --> LoginPage : Enters username and password
LoginPage --> AuthHandler : POST /api/auth/login
AuthHandler --> MongoRepository : VerifyCredentials()
MongoRepository --> MongoDB : findOne()
AuthHandler ..> Admin : Sets JWT session cookie

Admin --> Middleware : Accesses protected routes
Middleware --> LoginPage : Redirects if unauthenticated

Admin --> DashboardPage : Views live KPI metrics
DashboardPage --> MetricsHandler : GET /api/v1/metrics
MetricsHandler --> MongoRepository : GetMetricsAggregation()
MongoRepository --> MongoDB : aggregate()

Admin --> TransactionLogsPage : Views audit log
TransactionLogsPage --> TransactionsHandler : GET /api/v1/transactions
TransactionsHandler --> MongoRepository : GetTransactions(filters)
MongoRepository --> MongoDB : find()

Admin --> DataMapperPage : Inspects raw vs transformed payload
DataMapperPage --> TransactionsHandler : GET /api/v1/transactions/:id

note right of AuthHandler
  Validates admin credentials.
  Generates and returns JWT token 
  as HTTP-only cookie.
end note

note right of MetricsHandler
  Aggregates adapt_transaction_logs:
  - total_records, success_rate, 
    pending_count, quarantined_count
end note

note right of DataMapperPage
  Side-by-side payload inspector.
  SHA-256 hashed by default 
  for PHI protection.
end note

@enduml
