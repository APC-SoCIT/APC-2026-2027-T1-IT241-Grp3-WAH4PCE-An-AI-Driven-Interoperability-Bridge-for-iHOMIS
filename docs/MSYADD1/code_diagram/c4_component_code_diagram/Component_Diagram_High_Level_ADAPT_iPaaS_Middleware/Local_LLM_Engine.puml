@startuml Local_LLM_Engine
!theme plain
title C4 Level 4 — Code Diagram: Local Gemma 4 LLM Engine (AI Translator)

package "AI Translation Service (src/lib/ai.ts)" {
    class "transformWithAI(payload, direction)" as TransformWithAI <<Async Function>> {
        + execute(): TransformResult
    }
}

package "Local Model SDK Client" {
    class "Gemma 4 Client" as Gemma4Client <<SDK>> {
        + generateContent(prompt: String): JSON
    }
}

TransformWithAI --> Gemma4Client : submits prompt to local Gemma 4
Gemma4Client ..> TransformWithAI : returns generated JSON

@enduml
