@startuml Semantic_AI_Translator
!theme plain
title C4 Level 4 - Code Diagram: Semantic AI Translator

package "src/lib/ai.ts" {
    class AIService <<Service>> {
        + transformWithAI(data: JSON, direction: String): JSON
        + generatePrompt(schema: String): String
    }
    
    class PromptBuilder <<Helper>> {
        + build(context: Map): String
    }
}

package "Local Gemma 4 LLM Engine" {
    class "Gemma 4 LLM Client" as Gemma4Client <<Engine>>
}

AIService --> PromptBuilder : constructs prompt
AIService --> Gemma4Client : submits for Gemma 4 semantic inference

@enduml
